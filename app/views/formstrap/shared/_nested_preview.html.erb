<!-- Preview placeholder -->
<div class="formstrap-repeater-row-preview" role="button" data-nested-preview-target="preview" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-<%= id %>" aria-controls="offcanvasRight">
  <div class="pe-none" data-nested-preview-target="previewContent">
  </div>
</div>

<!-- Preview fields wrapper -->
<div class="offcanvas offcanvas-end nested-preview-offcanvas" tabindex="-1" id="offcanvas-<%= id %>" aria-labelledby="offcanvasRightLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasRightLabel">Edit fields</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">

    <!-- Row content -->
    <div data-nested-preview-target="fields">
      <%= yield %>
    </div>

    <!-- Preview sync button -->
    <div class="btn btn-primary" data-action="click->nested-preview#requestPreview">
      <%= bootstrap_icon("arrow-repeat") %> Sync preview
    </div>
  </div>
</div>

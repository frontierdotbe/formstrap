<div class="h-autocomplete d-none" data-autocomplete-target="dropdown">
<% if collection.any? %>
  <%= render "headmin/forms/autocomplete/list" do %>
    <% collection.each do |value, name| %>
      <%= render "headmin/forms/autocomplete/item", value: value do %>
        <%= name %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
</div>
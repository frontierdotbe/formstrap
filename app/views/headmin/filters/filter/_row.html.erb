<% row = Headmin::Filter::RowView.new(local_assigns) %>

<div class="h-filter-row" data-controller="filter-row" data-filter-target="row">
  <%= yield(row.operator, row.value) %>
  <button type="button" class="btn btn-sm btn-link h-filter-add-input" data-action="click->filter#add">
    <i class="bi bi-plus-circle"></i>
  </button>
  <button type="button" class="btn btn-sm btn-link h-filter-remove-input" data-action="click->filter#remove">
    <i class="bi bi-dash-circle"></i>
  </button>
</div>
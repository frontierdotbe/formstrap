<%#
    headmin/table/body/association
    accepts block: no
    parameters:
      value: (string) Name of the association
%>

<td>
  <% if defined?(url) && url %>
    <a href="<%= url %>" title="<% t(".open") %>" target=_blank>
      <% if value.respond_to?(:each) %>
        <%= value.map { |i| i.to_s }.join(", ") %>
      <% else %>
        <%= value.to_s %>
      <% end %>
      <%= bootstrap_icon("box-arrow-up-right") %>
    </a>
  <% else %>
    <% if value.respond_to?(:each) %>
      <%= value.map { |i| i.to_s }.join(", ") %>
    <% else %>
      <%= value.to_s %>
    <% end %>
  <% end %>
</td>
<%
  # headmin/dropdown
  #
  # ==== Options
  # * +class</tt> - Custom class names to put on the dropdown
  #
  # ==== Examples
  #   Basic version
  #   <%= render "headmin/dropdown" do %#>
  #     Your content
  #   <% end %#>

  class_names = local_assigns.has_key?(:class) ? local_assigns[:class] : "btn-group"
%>

<div class="dropdown <%= class_names %>">
  <%= yield %>
</div>
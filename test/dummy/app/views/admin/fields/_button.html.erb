<% named_group = local_assigns.has_key?(:named_group) ? local_assigns[:named_group] : true %>

<%= render "headmin/forms/fields/group", form: form, name: :button, named: named_group do |group| %>
  <div class="row">
    <div class="col-md-6">
      <%= render "headmin/forms/fields/text", form: group, name: :name do |field, attribute, label| %>
        <%= render "headmin/forms/text", form: field, attribute: attribute, label: label, required: true %>
      <% end %>
    </div>
    <div class="col-md-6">
      <%= render "headmin/forms/fields/text", form: group, name: :url do |field, attribute, label| %>
        <%= render "headmin/forms/url", form: field, attribute: attribute, label: label, required: true, prepend: bootstrap_icon("globe") %>
      <% end %>
    </div>
  </div>
<% end %>
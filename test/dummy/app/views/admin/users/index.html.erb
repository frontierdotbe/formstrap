<%= render "headmin/index" do %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: breadcrumbs.last&.name, new_link: new_admin_user_path %>
  <% end %>
  <%= render "headmin/table/header" do %>
    <%= render "headmin/filters", url: admin_users_path do |form| %>
      <%= render "headmin/filters/options", form: form, name: :role, label: User.human_attribute_name(:role), options: User.role.options %>
    <% end %>
    <%= render "headmin/pagination", collection: @users %>
  <% end %>
  <%= render "headmin/table" do %>
    <%= render "headmin/table/actions" do %>
      <%= render "headmin/table/actions/delete", url: destroy_admin_users_path %>
    <% end %>
    <%= render "headmin/table/head" do %>
      <%= render "headmin/table/head/id" %>
      <%= render "headmin/table/head/cell", value: User.human_attribute_name(:name), sort: :name %>
      <%= render "headmin/table/head/cell", value: User.human_attribute_name(:email), sort: :email %>
      <%= render "headmin/table/head/cell", value: User.human_attribute_name(:role), sort: :role %>
      <%= render "headmin/table/head/cell", value: User.human_attribute_name(:created_at), sort: :create_at %>
      <%= render "headmin/table/head/cell", value: User.human_attribute_name(:updated_at), sort: :updated_at %>
    <% end %>
    <%= render "headmin/table/body" do %>
      <% @users.each do |user| %>
        <%= render "headmin/table/body/row" do %>
          <%= render "headmin/table/body/id", value: user.id %>
          <%= render "headmin/table/body/string", value: user.name, url: admin_user_path(user) %>
          <%= render "headmin/table/body/text", value: user.email %>
          <%= render "headmin/table/body/text", value: user.role %>
          <%= render "headmin/table/body/date", value: user.created_at %>
          <%= render "headmin/table/body/date", value: user.updated_at %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "headmin/table/foot" %>
  <% end %>
  <%= render "headmin/table/footer" do %>
    <%= render "headmin/pagination/per_page" %>
    <%= render "headmin/pagination", collection: @users %>
  <% end %>
<% end %>

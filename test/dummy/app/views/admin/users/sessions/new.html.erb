<main class="form-signin text-center">

  <div class="form-signin-logo mb-4">
    <%= inline_svg_tag("logo.svg") %>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

    <div class="form-floating">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@example.com", class: "form-control" %>
      <%= f.label :email %>
    </div>
    <div class="form-floating">
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "password", class: "form-control" %>
      <%= f.label :password %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="checkbox mb-3">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <%= f.submit t(".login"), class: "btn btn-lg btn-primary w-100" %>
  <% end %>

  <p class="mt-5 mb-3 text-muted">&copy; <%= Time.now.strftime("%Y") %></p>

  <%= render "admin/users/shared/links" %>
</main>

<%= render "headmin/index" do %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: breadcrumbs.last&.name %>
  <% end %>
  <%= render "headmin/table" do %>
    <%= render "headmin/table/head" do %>
      <%= render "headmin/table/head/cell", value: Setting.human_attribute_name(:name), sort: :name %>
      <%= render "headmin/table/head/cell", value: Setting.human_attribute_name(:created_at), sort: :created_at %>
      <%= render "headmin/table/head/cell", value: Setting.human_attribute_name(:updated_at), sort: :updated_at %>
    <% end %>
    <%= render "headmin/table/body" do %>
      <% @settings.each do |setting| %>
        <%= render "headmin/table/body/row" do %>
          <%= render "headmin/table/body/string", value: setting.name, url: admin_setting_path(setting) %>
          <%= render "headmin/table/body/date", value: setting.created_at %>
          <%= render "headmin/table/body/date", value: setting.updated_at %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
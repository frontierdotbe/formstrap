<%= render "headmin/index" do %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: breadcrumbs.last&.name, new_link: new_admin_question_path %>
  <% end %>
  <%= render "headmin/table/header" do %>
    <%= render "headmin/pagination", collection: @questions %>
  <% end %>
  <%= render "headmin/table" do %>
    <%= render "headmin/table/head" do %>
      <%= render "headmin/table/head/id" %>
      <%= render "headmin/table/head/cell", value: Question.human_attribute_name(:title), sort: :title %>
      <%= render "headmin/table/head/cell", value: Question.human_attribute_name(:poll), sort: :poll %>
      <%= render "headmin/table/head/cell", value: Question.human_attribute_name(:points), sort: :points %>
      <%= render "headmin/table/head/cell", value: Question.human_attribute_name(:created_at), sort: :created_at %>
      <%= render "headmin/table/head/cell", value: Question.human_attribute_name(:updated_at), sort: :updated_at %>
    <% end %>
    <%= render "headmin/table/body" do %>
      <% @questions.each do |question| %>
        <%= render "headmin/table/body/row" do %>
          <%= render "headmin/table/body/id", value: question.id %>
          <%= render "headmin/table/body/string", value: question.title, url: admin_question_path(question) %>
          <%= render "headmin/table/body/association", value: question.poll, url: admin_poll_path(question.poll) %>
          <%= render "headmin/table/body/string", value: question.points %>
          <%= render "headmin/table/body/date", value: question.created_at %>
          <%= render "headmin/table/body/date", value: question.updated_at %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "headmin/table/foot" %>
  <% end %>
  <%= render "headmin/table/footer" do %>
    <%= render "headmin/pagination/per_page" %>
    <%= render "headmin/pagination", collection: @questions %>
  <% end %>
<% end %>
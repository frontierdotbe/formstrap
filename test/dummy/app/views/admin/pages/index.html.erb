<%= render "headmin/index" do %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: breadcrumbs.last&.name, new_link: new_admin_page_path %>
  <% end %>
  <%= render "headmin/table/header" do %>
    <%= render "headmin/filters" do |form| %>
      <%= render "headmin/filters/association", form: form, attribute: :parent %>
     <% end %>

    <%= render "headmin/pagination", collection: @pages %>
  <% end %>
  <%= render "headmin/table" do %>
    <%= render "headmin/table/actions" do %>
      <%= render "headmin/table/actions/delete", url: destroy_admin_pages_path %>
    <% end %>
    <%= render "headmin/table/head" do %>
      <%= render "headmin/table/head/id" %>
      <%= render "headmin/table/head/cell", value: Page.human_attribute_name(:title), sort: :title %>
      <%= render "headmin/table/head/cell", value: Page.human_attribute_name(:slug), sort: :slug %>
      <%= render "headmin/table/head/cell", value: Page.human_attribute_name(:parent), sort: :parent %>
      <%= render "headmin/table/head/cell", value: Page.human_attribute_name(:created_at), sort: :created_at %>
      <%= render "headmin/table/head/cell", value: Page.human_attribute_name(:updated_at), sort: :updated_at %>
    <% end %>
    <%= render "headmin/table/body" do %>
      <% @pages.each do |page| %>
        <%= render "headmin/table/body/row" do %>
          <%= render "headmin/table/body/id", value: page.id %>
          <%= render "headmin/table/body/string", value: page.title, url: admin_page_path(page) %>
          <%= render "headmin/table/body/string", value: page.slug %>
          <%= render "headmin/table/body/association", value: page.parent %>
          <%= render "headmin/table/body/date", value: page.created_at %>
          <%= render "headmin/table/body/date", value: page.updated_at %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "headmin/table/foot" %>
  <% end %>
  <%= render "headmin/table/footer" do %>
    <%= render "headmin/pagination/per_page" %>
    <%= render "headmin/pagination", collection: @pages %>
  <% end %>
<% end %>
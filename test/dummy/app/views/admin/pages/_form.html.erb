<%= formstrap_form_with model: [:admin, @page] do |form| %>
  <%= form.text :title, required: true, hint: "Test test test" %>
<% end %>
<%= render "headmin/form", model: [:admin, @page] do |form| %>
  <%= render "headmin/breadcrumbs" %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: @page.title, new_link: (new_admin_page_path if @page.persisted?) %>
  <% end %>
  <div class="row">
    <div class="col-lg-9">
      <%= render "headmin/forms/errors", form: form %>

      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">
            <%= t("admin.pages.form.info") %>
          </h5>
          <p class="cart-text text-secondary">
            <%= t("admin.pages.form.info_text") %>
          </p>
          <%= render "headmin/forms/association", form: form, attribute: :parent, include_blank: true %>
          <%= render "headmin/forms/text", form: form, attribute: :title, required: true %>
          <%= render "headmin/forms/text", form: form, attribute: :slug %>
          <%= render "headmin/forms/text", form: form, attribute: :handle %>
        </div>
      </div>

      <div class="card shadow-sm">
        <%= render "headmin/forms/blocks", form: form, names: %w(button image image_full_width image_text list text text_image gallery), paths: %w(admin/pages/blocks) %>
      </div>
    </div>

    <div class="col-md-3">
      <%= render "admin/shared/actions", form: form do %>
        <%= render "admin/shared/actions/view", url: page_path(slug: @page.slug) if @page.persisted? %>
      <% end %>
    </div>
  </div>
<% end %>

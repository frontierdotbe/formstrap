<%= render "headmin/form", model: [:admin, @poll] do |form| %>
  <%= render "headmin/breadcrumbs" %>
  <%= render "headmin/heading" do %>
    <%= render "headmin/heading/title", title: @poll.name, new_link: (new_admin_poll_path if @poll.persisted?) %>
  <% end %>
  <div class="row">
    <div class="col-lg-9">
      <%= render "headmin/forms/errors", form: form %>

      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">
            <%= t("admin.polls.form.info") %>
          </h5>
          <p class="cart-text text-secondary">
            <%= t("admin.polls.form.info_text") %>
          </p>
          <%= form.text :name, required: true %>
          <%= form.select :poll_type, required: true, collection: Poll.poll_type.options %>
          <%= form.flatpickr_range :runtime, start: {attribute: :start_date}, end: {attribute: :end_date} %>
          <%= form.association_field :questions %>
          <%= render "headmin/forms/fields/list", form: form, name: :tests do |list, attribute, label| %>
            <%= render "headmin/forms/fields/text", form: list, name: :hello, attribute: attribute do |field, attribute, label| %>
              <%= field.text attribute, label: label, maxlength: 60, hint: t("admin.shared.forms.seo.title_hint"), required: true %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <%= render "admin/shared/actions", form: form %>
    </div>
  </div>
<% end %>
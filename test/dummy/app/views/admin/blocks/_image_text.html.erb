<div class="row">
  <div class="col-md-2">
    <%= render "headmin/forms/fields/file", form: form, name: :image do |field, attribute, label| %>
      <%= render "headmin/forms/media", form: field, attribute: attribute, label: label %>
    <% end %>
  </div>
  <div class="col-md-10">
    <%= render "headmin/forms/fields/text", form: form, name: :text do |field, attribute, label| %>
      <%= render "headmin/forms/wysiwyg", form: field, attribute: attribute, label: label, toolbar: false %>
    <% end %>
  </div>
</div>
